{
  "custom": {},
  "params": {
    "icon_path": "material/settings"
  },
  "propConfig": {
    "params.icon_path": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 100,
      "width": 120
    }
  },
  "root": {
    "children": [
      {
        "meta": {
          "name": "Icon"
        },
        "position": {
          "basis": "100%",
          "grow": 1
        },
        "propConfig": {
          "props.path": {
            "binding": {
              "config": {
                "path": "view.params.icon_path"
              },
              "type": "property"
            }
          }
        },
        "type": "ia.display.icon"
      }
    ],
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "Tabs/Body",
        "padding": "5px"
      }
    },
    "type": "ia.container.flex"
  }
}