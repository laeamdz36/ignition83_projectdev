                "propConfig": {
                  "props.value": {
                    "onChange": {
                      "enabled": null,
                      "script": "\t# Date validation\n\t# avoid user selection above 1 month\n\tstart_date \u003d self.props.value\n\tend_date \u003d self.getSibling(\"dti_end_date\").props.value\n\tif end_date is not None:\n\t\tdiff \u003d system.date.daysBetween(start_date, end_date)\n\telse:\n\t\treturn\n\tpopup_view \u003d \"popups/notify_result\"\n\tpopup_parmas \u003d {\"icon_path\": \"material/done\", \"header\":\"Date Range Invalid\", \"text_feedback\": \"Diff range: {}\".format(diff)}\n\tif diff \u003e 30 or diff \u003c 0:\n\t\t# open pop-up, may be no need, i left deactivate and only we clean the end_date value\n\t\tself.getSibling(\"dti_end_date\").props.value \u003d None\n\t\t#system.perspective.openPopup(\"register_result\", popup_view, params \u003d popup_parmas, showCloseIcon \u003d True, resizable \u003d False, draggable\u003d False)\n\t\t"
                    }
                  }
                },
                "props": {
                  "formattedValue": "Nov 17, 2026 12:00 AM",
                  "value": {
                    "$": [
                      "ts",
                      0,
                      1795127518473
                    ],
                    "$ts": 1794895200000
