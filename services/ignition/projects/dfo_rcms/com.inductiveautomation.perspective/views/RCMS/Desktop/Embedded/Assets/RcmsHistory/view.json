    "custom.history_date_range": {
      "binding": {
        "config": {
          "struct": {
            "end_date": "if({/root/Body/date_inputs/dti_end_date.props.value} !\u003d None, toMillis({/root/Body/date_inputs/dti_end_date.props.value}), None)\r\n",
            "start_date": "if({/root/Body/date_inputs/dti_start_date.props.value} !\u003d None, toMillis({/root/Body/date_inputs/dti_start_date.props.value}), None)"
          },
          "waitOnAll": true
        },
        "type": "expr-struct"
      },
      "persistent": true
    }
  },
