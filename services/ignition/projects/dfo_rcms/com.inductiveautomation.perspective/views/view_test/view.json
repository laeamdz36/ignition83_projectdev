                "onActionPerformed": {
                  "config": {
                    "script": "\t# retrieve data for the asset name and return the url\n\tselection \u003d str(self.view.custom.dd_selection)\n\t\n\t# put in the params dict config the asset name for the asset requeste\n\tparams \u003d {\"asset_name\": selection}\n\tparams[\"asset_type\"] \u003d dfo_rcms.v1.utils.get_asset_prefix(selection)\n\tparams[\"ip_client\"] \u003d str(self.session.props.host)\n\tparams[\"client_session\"] \u003d dict(self.session.props.auth)\n\t\n\n\t# get the url \u0027dfov1\u0027\n\turl_type \u003d \"dfov1\"\n\t\n\tlogger \u003d system.util.getLogger(\"rcms_dev\")\n\t\n\t\n\tclient_session \u003d dict(self.session.props.auth)\n\tlogger.info(\"Client session: %s\" % (client_session))\n\t\n\t\n\t#url \u003d dfo_rcms.dev1.get_url(url_type, config)\n\turl \u003d dfo_rcms.v1.url.get_url(url_type, params)\n\tself.view.custom.url \u003d url"
                  },
                  "scope": "G",
                  "type": "script"
                }
