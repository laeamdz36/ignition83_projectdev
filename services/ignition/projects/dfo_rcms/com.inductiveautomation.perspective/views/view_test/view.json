  "events": {
    "system": {
      "onStartup": {
        "config": {
          "script": "\timport re\n\t# create the array for the cms assets\n\t\n\tscope \u003d [\"QC\", \"RTG\"]\n\troot_path \u003d \"[Aggregator]asset\"\n\tscope_filters \u003d [{\"name\": \"*{}*\".format(asset_type)} for asset_type in scope]\n\ttags \u003d []\n\tfor f in scope_filters:\n\t    tags.extend(system.tag.browse(root_path, f))\n\t    \n\tassets \u003d []\n\tfor tag_folder in tags:\n\t\tpath \u003d tag_folder.get(\"fullPath\")\n\t\ttags \u003d system.tag.browse(path)\n\t\tassets.extend([str(tag[\"name\"]) for tag in tags])\n\t\n\tdef get_asset_prefix(tag_name):\n\t    # Busca una o más letras al inicio de la cadena\n\t    match \u003d re.match(r\u0027^([A-Za-z]+)\u0027, tag_name)\n\t    return match.group(1) if match else None\n\t\t\n\t# create the options array\n\toptions \u003d [{\"value\": asset, \"label\": asset} for asset in assets]\n\tself.view.custom.options \u003d options"
        },
        "scope": "G",
        "type": "script"
      }
    }
  },
  "params": {},
  "propConfig": {
    "custom.dd_selection": {
      "binding": {
        "config": {
          "path": "/root/FlexContainer/Dropdown.props.value"
