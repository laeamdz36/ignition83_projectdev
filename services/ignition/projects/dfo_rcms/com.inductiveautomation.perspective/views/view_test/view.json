            "start_date": "if({/root/date_inputs/dti_start_date.props.value} !\u003d None, toMillis({/root/date_inputs/dti_start_date.props.value}), None)"
          },
          "waitOnAll": true
        },
        "type": "expr-struct"
      },
      "persistent": true
    }
  },
