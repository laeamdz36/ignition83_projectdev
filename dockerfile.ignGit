FROM inductiveautomation/ignition:8.3.10

USER root
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y git nano

# Thin wrapper around the official entrypoint; Git is managed from the host repository.
COPY provisioning/ignition-entrypoint.sh /usr/local/bin/ignition-entrypoint.sh
# Elimina finales de línea CRLF (archivos editados en Windows) y da permisos de ejecución
RUN sed -i 's/\r$//' /usr/local/bin/ignition-entrypoint.sh && \
    chmod 755 /usr/local/bin/ignition-entrypoint.sh

USER ignition

ENTRYPOINT ["tini", "-g", "--", "/usr/local/bin/ignition-entrypoint.sh"]
